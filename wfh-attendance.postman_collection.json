                        {
                            "name": "Clock In",
                            "event": [
                                {
                                    "listen": "test",
                                    "script": {
                                        "exec": [
                                            "const response = pm.response.json();",
                                            "if (response && response.success && response.data && response.data.attendance) {",
                                            "    const imageUrl = response.data.attendance.image;",
                                            "    const parts = imageUrl.split('/');",
                                            "    const filename = parts[parts.length - 1];",
                                            "    pm.collectionVariables.set(\"attendance_filename\", filename);",
                                            "}"
                                        ],
                                        "type": "text/javascript"
                                    }
                                }
                            ],
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Authorization",
                                        "value": "Bearer {{access_token}}",
                                        "type": "text"
                                    }
                                ],
                                "body": {
                                    "mode": "formdata",
                                    "formdata": [
                                        {
                                            "key": "image",
                                            "type": "file",
                                            "src": []
                                        },
                                        {
                                            "key": "notes",
                                            "value": "Slicing landing page UI",
                                            "type": "text"
                                        }
                                    ]
                                },
                                "url": {
                                    "raw": "{{gateway_url}}/{{api_path}}/{{api_version}}/attendances/clockin",
                                    "host": [
                                        "{{gateway_url}}/{{api_path}}/{{api_version}}"
                                    ],
                                    "path": [
                                        "attendances",
                                        "clockin"
                                    ]
                                }
                            },
                            "response": []
                        },
