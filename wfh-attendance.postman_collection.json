                                    "host": [
                                        "{{gateway_url}}/{{api_path}}/{{api_version}}"
                                    ],
                                    "path": [
                                        "attendances",
                                        "uploads",
                                        ":filename"
                                    ],
                                    "query": [
                                        {
                                            "key": "token",
                                            "value": "{{access_token}}"
                                        }
                                    ],
                                    "variable": [
                                        {
                                            "key": "filename",
                                            "value": "{{attendance_filename}}",
                                            "description": "The attendance image filename returned from clock-in"
